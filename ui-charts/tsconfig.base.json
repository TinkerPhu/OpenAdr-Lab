// Shared by VEN/ui and VTN/ui (each tsconfig.json extends this). `include` is NOT shared: it is
// resolved relative to the file that declares it, so each app lists its own.
{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "types": ["vitest/globals", "vite/client"],
    // Relative to THIS file, so `@lab/charts` is ui-charts/src whichever app extends it.
    // `@lab/charts` is the shared source. Its own bare imports (react, recharts, MUI) need no
    // mapping: the npm workspace root hoists them to /node_modules, which is on the resolution
    // path from anywhere in the repo. That hoisting is also what guarantees one copy of React
    // in the bundle.
    "baseUrl": ".",
    "paths": { "@lab/charts/*": ["src/*"] }
  }
}
