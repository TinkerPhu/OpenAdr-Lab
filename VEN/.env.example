# VEN stack - environment overrides for docker-compose.yml. Copy to VEN/.env (git-ignored) on the host.
# Without it the stack runs on the neutral placeholder site shipped in the repo.

# Site id: the <site> segment of every weather / measurement / forecast topic
# (<root>/weather/<site>/forecast, <root>/forecast/<site>/..., ...). It must be the same for the
# weather publisher, the lab-forecaster and every VEN, or a VEN silently falls back to its own forecast.
SITE_ID=hometown

# Directory holding the profile YAMLs (ven-1.yaml, ...). The repo profiles carry placeholder
# coordinates (Bern, 46.9480 / 7.4474); to run on a real location keep copies with your own
# latitude_deg / longitude_deg in VEN/profiles-local/ (git-ignored) and point this at it.
# Relative paths resolve against the compose file's directory.
# PROFILES_DIR=./profiles-local
