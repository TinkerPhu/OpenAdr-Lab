# node2 - environment overrides for docker-compose.yml. Copy to .env (git-ignored) on the Node2 host.
# See README.md in this directory.

# The primary host's LAN IP (runs the VTN + BFF that node2's ven-4/ui depend on). Used in
# docker-compose.yml (env-var substituted) and hardcoded in nginx/nginx.conf - keep both in sync.
PRIMARY_HOST_LAN_IP=192.0.2.10
