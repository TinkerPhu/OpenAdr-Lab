# node2 (currently Po4) — environment overrides for docker-compose.yml
# See README.md in this directory for why this deployment is structured
# this way. Committed with real lab values, same convention as VTN/.env —
# this is local-network config, not a secret.

# Primary host's real LAN IP (runs the VTN + BFF that node2's ven-4/ui
# depend on). Used both in docker-compose.yml (env-var substituted) and
# hardcoded in nginx/nginx.conf (plain nginx config isn't env-templated at
# container start — keep both in sync if this ever changes).
PRIMARY_HOST_LAN_IP=192.168.1.103
