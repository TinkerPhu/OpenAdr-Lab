[Unit]
Description=OpenADR Lab CI runner (works through the handoff board)
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=@USER@
# CI_HOME_NAME and CI_LANE_HOSTS (see ci/README.md); the file is optional
EnvironmentFile=-/srv/ci/runner.env
ExecStart=/srv/ci/bin/ci/runner.sh
# A full suite takes about an hour; leave room for a cold toolchain build and a retry.
TimeoutStartSec=5h
