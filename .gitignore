# Generated by Cargo
# will have compiled files and executables
debug
target

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# RustRover
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/

# Docker bind-mount data directories
**/data/

# fleet.sh-generated artifacts (regenerated per run, host-local)
VEN/docker-compose.fleet.yml
VEN/fleet/
VEN/profiles/fleet-ven-*.yaml

# experiments/run_experiment.py output (host-local run snapshots).
# `experiments/results/*` rather than `experiments/results/` so the curated
# planner result store below can be re-included: git cannot re-include a path
# whose parent DIRECTORY is excluded, only one whose contents are.
experiments/results/*
# R-97 planner solve-cost store: small, curated, commit-stamped, and the only
# record of non-reproducible measurements (time-limited solves, live fleet
# observations). It was ignored along with the run snapshots until 2026-10-02,
# which left ~150 rows of this investigation on one laptop and nowhere else.
!experiments/results/planner/
experiments/run_logs/

# cargo-tarpaulin coverage reports (GB-30, docs/BACKLOG.md — host-local, regenerated per run)
coverage/

# Python
__pycache__/
*.pyc
*.pyo

# Test artifacts
*.output
*.stackdump

# Claude Code local settings
.claude/settings.local.json
*.bkp
*.dtmp
*.pdf

# Git worktrees
.claude/worktrees/
docs/plans/notes.json
.claude/scheduled_tasks.lock

openspec/changes/pv-self-consumption-reward/*
**/.openspec.yaml
.obsidian/*

# npm workspace root: dependencies hoist here from VEN/ui and VTN/ui
/node_modules/

# Derived per-VEN broker passwords (scripts/gen_fleet_mqtt_secrets.py).
# Regenerated from the root secret on each host; never committed.
.env.fleet
**/.env.fleet
# ...and the per-VEN files beside it, each holding one VEN's own password.
.env.fleet.*
**/.env.fleet.*

