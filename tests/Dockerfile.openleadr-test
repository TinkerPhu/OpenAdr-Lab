###############################################################################
# Dockerfile for running openleadr-rs cargo tests.
#
# Build context: ../openleadr-rs (the submodule root)
# Used by: tests/docker-compose.openleadr-test.yml
#
# Compiled artifacts live in named Docker volumes (see docker-compose), so
# only changed crates are recompiled on each run. First run is slow (~25 min
# on Node1 ARM64); subsequent runs are ~1-2 min.
###############################################################################

# Must be >= the openleadr-rs workspace MSRV (1.91) and is kept on the same
# version its own vtn.Dockerfile uses, so the test image and the shipped image
# do not compile the submodule with different compilers.
FROM rust:1.94-alpine
# cmake is not optional from 3.1 on: `paho-mqtt-sys` cmake-builds the bundled
# Paho C library, and without it the build script exits 101 after the whole
# dependency tree has compiled -- a ~20 minute wait for a missing package.
# openleadr-rs's own vtn.Dockerfile installs the same set.
RUN apk add --no-cache alpine-sdk cmake g++ make openssl-dev openssl-libs-static
WORKDIR /app
COPY . .
ENV SQLX_OFFLINE=true
ENV RUST_BACKTRACE=1
ENV CARGO_BUILD_JOBS=4
# `internal-oauth` is not a default feature, and the VTN's own test code uses
# what it gates -- `JwtManager::create`, `Scope::WriteUsers` -- so `cargo test
# --workspace` on the default feature set does not compile. It is also the
# feature set the shipped image is built with (openleadr-rs/vtn.Dockerfile),
# so testing without it would exercise a different binary than we deploy.
CMD ["cargo", "test", "--workspace", "--features", "openleadr-vtn/internal-oauth"]
