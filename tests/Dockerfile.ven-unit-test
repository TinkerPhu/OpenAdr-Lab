###############################################################################
# Dockerfile for running VEN (Rust backend) cargo unit tests.
#
# Build context: the repo root (see `context: ..` in the compose file) - both
# the VEN crate and its `lab-core` path dependency have to be reachable.
# Used by: tests/docker-compose.ven-unit-test.yml
#
# Compiled artifacts live in named Docker volumes (see compose file), so
# only changed files are recompiled on each run. First run is slow (~20 min
# on Node1 ARM64 — HiGHS + aws-lc-rs C++ builds); subsequent runs are ~1-2 min.
#
# Usage (on Node1):
#   cd /srv/docker/openadr_lab
#   docker compose -f tests/docker-compose.ven-unit-test.yml run --build --rm ven-unit-test
###############################################################################

# Must track VEN/rust-toolchain.toml: `openleadr-wire` sets an MSRV of 1.91, and a base
# image older than that fails the build with a version error rather than a type error.
FROM rust:1.91-bookworm

# HiGHS and aws-lc-rs need cmake + clang; bookworm provides them.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        cmake \
        pkg-config \
        libclang-dev \
        libssl-dev \
    && rm -rf /var/lib/apt/lists/*

RUN rustup component add rustfmt clippy

# `cargo audit` is part of the pre-merge gate (the CI runner runs it in this image). Its own
# layer: compiling it takes a while on ARM and no source change should redo that.
RUN cargo install cargo-audit --locked

WORKDIR /app

# Context is the repo root (for `lab-core`, the crate the VEN shares with the
# BFF), so copy the two crates rather than the whole tree.
#
# `lab-core` lands at `/lab-core`, NOT `/app/lab-core`: VEN/Cargo.toml declares
# `lab-core = { path = "../lab-core" }`, and `..` from the VEN crate root at
# `/app` is the filesystem root. Copying it inside `/app` put it somewhere cargo
# never looks, and the build failed before compiling anything with
# "failed to read `/lab-core/Cargo.toml`" - naming the path it wanted, which is
# the one used here.
#
# The sibling layout is what the path dependency means, so it is reproduced
# rather than worked around. `/app` stays the VEN crate root so the cache volume
# mounted at `/app/target` keeps its paths.
COPY VEN/ ./
COPY lab-core/ /lab-core/

# Keep parallelism low to avoid OOM linker failures on Node1
# (linking HiGHS + aws-lc-rs simultaneously exceeds 1500 MiB).
ENV CARGO_BUILD_JOBS=2
ENV RUST_BACKTRACE=1

# Cargo trusts file times for path crates. A cached COPY layer keeps the times of the build that
# made it, so once another branch has compiled into the shared target volume these sources look
# older than its artifacts and cargo reuses them (the CI runner checked a branch against main's
# lab-core). Stamping them when the container starts makes every run compile what it was given;
# a RUN step would not help, the layer cache replays it with the old times.
ENTRYPOINT ["sh", "-c", "find /app/src /app/tests /app/benches /lab-core -name '*.rs' -exec touch {} + 2>/dev/null; exec \"$@\"", "--"]

CMD ["cargo", "test", "--jobs", "2"]
