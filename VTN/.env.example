# OpenADR VTN stack - environment variables. Copy to .env (git-ignored) on the host and adjust.
# Every variable has a default in docker-compose.yml, so an absent .env still starts the stack,
# but the database password must match the one the db volume was initialised with.

# PostgreSQL
PG_USER=openadr
PG_DB=openadr
PG_PASSWORD=change-me
PG_PORT=8201
PG_TZ=UTC

# VTN
VTN_PORT=8200
RUST_LOG=info
DATABASE_URL=postgres://openadr:change-me@db:5432/openadr

# OAuth (internal provider defaults - VTN auto-generates HMAC secret if omitted)
# OAUTH_TYPE=
# OAUTH_KEY_TYPE=
# OAUTH_BASE64_SECRET=
